# ─── LumixPay API — environment variables ─────────────────────────────────────
# Copy this file to .env (repo root) for local development.
# In production (Fly.io) set these via: fly secrets set KEY=value

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Database ───────────────────────────────────────────────────────────────────
# Full connection string takes priority over individual vars
DATABASE_URL=postgresql://lumixpay:lumixpay_secret@localhost:5432/lumixpay

# Individual vars (used only when DATABASE_URL is not set)
# POSTGRES_USER=lumixpay
# POSTGRES_PASSWORD=lumixpay_secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=lumixpay

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret:  openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL. Accepts * for development only.
CORS_ORIGIN=https://lumixpay.vercel.app

# ── VAPID (Push Notifications) ─────────────────────────────────────────────────
# Generate a VAPID key pair once:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@lumixpay.com

# ── Google Login (OAuth / Identity Services) ──────────────────────────────────
# Create credentials in Google Cloud Console:
#  - OAuth Client ID (Web application)
#  - Add Authorized JavaScript origins for your frontend domain(s)
#  - Add Authorized redirect URIs if you later move to code flow (not needed for ID token flow)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Admin seed ────────────────────────────────────────────────────────────────
# Set to true only on first deploy to create the initial admin account.
# Must also set SEED_ADMIN_EMAIL + SEED_ADMIN_PASSWORD + SEED_ADMIN_NAME.
LUMIX_SEED_ADMIN=false
# SEED_ADMIN_EMAIL=admin@lumixpay.com
# SEED_ADMIN_PASSWORD=change_this_admin_password
# SEED_ADMIN_NAME=LumixPay Admin

# ── Platform fee ─────────────────────────────────────────────────────────────
PLATFORM_FEE_RATE=0.01

# ── Optional XRPL profile wallet (Testnet) ───────────────────────────────────
# No secrets required. Users link a Testnet address via signed challenge
# (see /me/profile/wallet/*). Public endpoints are documented in API responses.

# ── XRPL Testnet faucet ──────────────────────────────────────────────────────
# Official XRPL Testnet faucet. Funds existing custodial wallet addresses automatically
# after signup by POSTing { "destination": "<address>" }.
# Set to false to disable automatic faucet funding on signup (manual via POST /me/wallet/fund-testnet).
XRPL_TESTNET_FAUCET_URL=https://faucet.altnet.rippletest.net/accounts
# JSON-RPC HTTP endpoint for account_info verification (plain HTTP, port 51234).
# Used to confirm the account is on-ledger after faucet funding (30 s polling).
XRPL_TESTNET_RPC_URL=http://s.altnet.rippletest.net:51234
XRPL_AUTO_FUND_CUSTODIAL_WALLETS=true

# ── Custodial XRPL wallet encryption ─────────────────────────────────────────
# WALLET_MASTER_KEY: 32-byte random value, base64url-encoded.
# Used to AES-256-GCM encrypt custodial XRPL wallet seeds stored in user_wallets.
#
# Generate a fresh key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# In development: if unset, wallet provisioning is SKIPPED with a warning.
# In production:  registration will FAIL if this is not set — set via Fly.io secrets:
#   fly secrets set WALLET_MASTER_KEY=<output_of_command_above>
#
# NEVER commit this value. NEVER log it. Back it up securely.
# For mainnet: migrate to AWS KMS / GCP Cloud KMS before handling real funds.
WALLET_MASTER_KEY=

# Key version tag for rotation. Increment to "v2" etc. when rotating keys.
# Old ciphertexts retain their prefix and can be decrypted with the old key
# until a re-encryption migration is complete.
WALLET_ENCRYPTION_KEY_ID=v1

# ── XRPL Testnet issued currency / trust lines (Phase 2B) ────────────────────
# TESTNET ONLY. These are test tokens with no real-world value.
# NEVER use official mainnet RLUSD/EURQ issuers here.
#
# ONE issuer wallet issues both RLUSD_TEST and EURQ_TEST on XRPL Testnet.
# The same wallet address must have DefaultRipple enabled via setup-testnet-issuer script.
#
# How to create the issuer wallet:
#   node -e "const k=require('ripple-keypairs');const s=k.generateSeed();\
#     const {publicKey}=k.deriveKeypair(s);\
#     const a=k.deriveAddress(publicKey);\
#     console.log('address:',a,'\\nseed:',s)"
#
# Then fund it at: https://faucet.altnet.rippletest.net (paste the address)
# Then enable DefaultRipple: cd apps/api && npm run xrpl:setup-issuer
#
# Safety: TrustLineService refuses to run if:
#   - XRPL_TESTNET_ISSUER_ADDRESS does not start with 'r'
#   - XRPL_TESTNET_RPC_URL does not contain 'altnet' or 'rippletest'
#
XRPL_TESTNET_ISSUER_ADDRESS=
# NEVER commit the issuer seed. Set via Fly.io secrets: fly secrets set XRPL_TESTNET_ISSUER_SEED=...
XRPL_TESTNET_ISSUER_SEED=

# Human-readable currency code names (TrustLineService converts to 20-byte hex for XRPL transactions)
XRPL_TESTNET_RLUSD_CURRENCY=RLUSD
XRPL_TESTNET_EURQ_CURRENCY=EURQ

# Maximum trust limit (string decimal). 1 billion test tokens per currency.
XRPL_TESTNET_TRUST_LIMIT=1000000000

# Set to false to disable automatic trust line setup on wallet funding (manual via POST /me/wallet/setup-trust-lines)
XRPL_AUTO_SETUP_TRUST_LINES=true

# ── Settlement provider (Phase 3C) ───────────────────────────────────────────
# Controls which backend executes withdrawal settlement.
#
#   mock         (default) — confirms immediately, no network calls.
#                             Use for development and staging without real XRPL keys.
#
#   xrpl_testnet (Phase 3C) — sends real XRPL Testnet issued-currency Payments
#                             from the configured treasury/issuer wallet.
#                             Requires XRPL_TESTNET_ISSUER_ADDRESS + XRPL_TESTNET_ISSUER_SEED above.
#                             TESTNET ONLY — tokens have no real-world value.
#                             Do NOT use for mainnet or real funds.
#
#   xrpl         (future)   — mainnet production settlement (not yet implemented).
#
SETTLEMENT_PROVIDER=mock

# ── XRPL Testnet issued token drops (Phase 2C) ───────────────────────────────
# WARNING: These are testnet-only test token drops.
# They do NOT represent official RLUSD or EURQ.
# They have no real-world monetary value.
# Never use mainnet issuer addresses or amounts here.
#
# Users with funded custodial wallets and established trust lines can request
# test tokens via POST /me/wallet/request-test-token.
# The issuer wallet (XRPL_TESTNET_ISSUER_ADDRESS above) sends the tokens directly.
# No internal LumixPay balances are affected.
#
# Set XRPL_TEST_TOKEN_DROP_ENABLED=false to disable the feature globally.
XRPL_TEST_TOKEN_DROP_ENABLED=true

# Amount of each token sent per drop request (cannot be overridden by users)
XRPL_TEST_TOKEN_DROP_RLUSD_AMOUNT=100
XRPL_TEST_TOKEN_DROP_EURQ_AMOUNT=100

# Minimum hours between drop requests per user per currency (anti-abuse cooldown)
XRPL_TEST_TOKEN_DROP_COOLDOWN_HOURS=24
